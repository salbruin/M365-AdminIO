# M365 OneDrive Scanner Cron Schedule
# Format: minute hour day month dayofweek command

# Run daily at 2 AM
0 2 * * * cd /app && python scanner.py >> /app/logs/cron.log 2>&1

# Run weekly on Monday at 3 AM
# 0 3 * * 1 cd /app && python scanner.py --min-risk high >> /app/logs/cron.log 2>&1

# Run every 6 hours
# 0 */6 * * * cd /app && python scanner.py >> /app/logs/cron.log 2>&1
