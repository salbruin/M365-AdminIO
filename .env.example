# M365 Application Registration Settings
# Register your app at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade

# Azure AD Application (Client) ID
CLIENT_ID=your-client-id-here

# Azure AD Tenant ID
TENANT_ID=your-tenant-id-here

# Client Secret (for application permissions)
CLIENT_SECRET=your-client-secret-here

# Redirect URI (for interactive login)
REDIRECT_URI=http://localhost:8000

# Scanning Configuration
SCAN_ALL_USERS=true
SPECIFIC_USERS=user1@domain.com,user2@domain.com

# Link Types to Flag
FLAG_ANYONE_LINKS=true
FLAG_ORG_LINKS=false
FLAG_SPECIFIC_PEOPLE=false

# Sensitive Data Patterns (regex)
SENSITIVE_PATTERNS=SSN,Credit Card,API Key,Password

# Output Settings
OUTPUT_FORMAT=json,csv,html
OUTPUT_DIR=./reports

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/scanner.log
